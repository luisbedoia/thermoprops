{
  "name": "thermoprops",
  "homepage": "https://luisbedoia.github.io/thermoprops/",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "author": "Luis Fernando Arias Bedoya",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build --base=/thermoprops/ && node scripts/postbuild.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist",
    "og-image": "node scripts/og-image.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@luisbedoia/coolprop-rs-wasm": "0.1.7",
    "katex": "^0.16.11",
    "lucide-react": "1.52.0",
    "plotly.js-dist-min": "^3.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.5.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/plotly.js": "^3.0.8",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "gh-pages": "^6.3.0",
    "globals": "^17.13.0",
    "jsdom": "^29.0.2",
    "prettier": "^3.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.5",
    "workbox-core": "^7.3.0",
    "workbox-window": "^7.3.0"
  }
}
