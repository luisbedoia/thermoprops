{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "thermoprops-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Per IP and per Cloudflare location, approximate (see src/index.ts).
  "ratelimits": [
    {
      "name": "LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  // Short links to the Worksheet (src/links.ts); its table in migrations/.
  "d1_databases": [
    {
      "binding": "LINKS",
      "database_name": "thermoprops-links",
      "database_id": "40d0f622-c5c4-4081-8ea2-9ac4e9af682d",
    },
  ],
}
