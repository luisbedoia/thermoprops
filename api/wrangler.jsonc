{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "thermoprops-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Per IP and per Cloudflare location, approximate (see src/index.ts).
  "ratelimits": [
    {
      "name": "LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
}
